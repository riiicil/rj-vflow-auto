{
  "manifest_version": 3,
  "name": "RJ V-Flow Auto",
  "version": "2.1.5",
  "description": "Automate Labs Flow generation workflows.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "sidePanel",
    "downloads",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": [
    "https://veo.genaipro.vn/fx/tools/flow/project/",
    "*://veo.genaipro.vn/fx/tools/flow/*",
    "*://veo.genaipro.vn/fx/id/tools/flow/project/*",
    "*://veo.genaipro.vn/fx/id/tools/flow/*",
    "*://veo.genaipro.vn/*",
    "*://*.labs.google/fx/*/tools/flow/*",
    "*://*.labs.google/fx/tools/flow/*",
    "*://*.labs.google/fx/id/tools/flow/*",
    "https://labs.google/fx/id/tools/flow/*",
    "https://labs.google/fx/tools/flow/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://veo.genaipro.vn/fx/tools/flow/project/",
        "*://veo.genaipro.vn/fx/tools/flow/*",
        "*://veo.genaipro.vn/fx/id/tools/flow/project/*",
        "*://veo.genaipro.vn/fx/id/tools/flow/*",
        "*://veo.genaipro.vn/*",
        "*://*.labs.google/fx/*/tools/flow/*",
        "*://*.labs.google/fx/tools/flow/*",
        "*://*.labs.google/fx/id/tools/flow/*",
        "https://labs.google/fx/id/tools/flow/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel/sidepanel.html"
  }
}